<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Request a Print"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary_light"
        android:layout_marginBottom="16dp" />

    <EditText
        android:id="@+id/documentLinkInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Google Drive Link"
        android:inputType="textUri"
        android:padding="14dp"
        android:textColor="@color/text_primary_light"
        android:textColorHint="@color/text_secondary_light"
        android:background="@drawable/bg_input_field"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/copiesInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Number of Copies"
        android:inputType="number"
        android:padding="14dp"
        android:textColor="@color/text_primary_light"
        android:textColorHint="@color/text_secondary_light"
        android:background="@drawable/bg_input_field"
        android:layout_marginBottom="12dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Print Type"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@color/text_primary_light"
        android:layout_marginBottom="8dp" />

    <RadioGroup
        android:id="@+id/colorModeGroup"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="12dp">

        <RadioButton
            android:id="@+id/blackWhiteRadio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Black &amp; White"
            android:textColor="@color/text_primary_light"
            android:checked="true" />

        <RadioButton
            android:id="@+id/colorRadio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Color"
            android:textColor="@color/text_primary_light" />
    </RadioGroup>

    <EditText
        android:id="@+id/specialRequestInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Special Request (e.g. double-sided, staple, specific pages)"
        android:inputType="textMultiLine"
        android:minLines="3"
        android:padding="14dp"
        android:textColor="@color/text_primary_light"
        android:textColorHint="@color/text_secondary_light"
        android:background="@drawable/bg_input_field"
        android:layout_marginBottom="20dp" />

    <Button
        android:id="@+id/submitPrintRequestButton"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Submit Print Request"
        android:padding="16dp"
        android:backgroundTint="@color/primary_green" />

</LinearLayout>