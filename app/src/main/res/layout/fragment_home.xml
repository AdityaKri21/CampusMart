<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:layout_marginTop="20dp">


    <LinearLayout
        android:id="@+id/fixedHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@color/background_light"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp"
            android:gravity="center_horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="CampusMart"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="@color/primary_green" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Your Campus, Everything You Need"
                android:textSize="13sp"
                android:textColor="@color/text_secondary_light"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp"
            app:cardBackgroundColor="@color/surface_light">

            <EditText
                android:id="@+id/searchInput"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="14dp"
                android:hint="Search vendors, products..."
                android:textColor="@color/text_primary_light"
                android:textColorHint="@color/text_secondary_light"
                android:drawableStart="@android:drawable/ic_menu_search"
                android:drawablePadding="8dp"
                android:background="@android:color/transparent"
                android:inputType="text" />

        </androidx.cardview.widget.CardView>

    </LinearLayout>

    <!-- SCROLLABLE section: categories + vendor list -->
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/fixedHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Category row -->
            <HorizontalScrollView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:scrollbars="none"
                android:paddingBottom="16dp"
                android:paddingTop="4dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:paddingHorizontal="16dp">

                    <LinearLayout
                        android:id="@+id/categoryFoodContainer"
                        android:layout_width="72dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginEnd="12dp">

                        <ImageView
                            android:id="@+id/foodIcon"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_food"
                            android:background="@drawable/bg_category_circle"
                            android:padding="12dp" />

                        <TextView
                            android:id="@+id/foodLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Food"
                            android:textSize="12sp"
                            android:textColor="@color/text_primary_light"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/categoryStationeryContainer"
                        android:layout_width="72dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginEnd="12dp">

                        <ImageView
                            android:id="@+id/stationeryIcon"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_stationery"
                            android:background="@drawable/bg_category_circle"
                            android:padding="12dp" />

                        <TextView
                            android:id="@+id/stationeryLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Stationery"
                            android:textSize="12sp"
                            android:textColor="@color/text_primary_light"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/categoryPrintingContainer"
                        android:layout_width="72dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginEnd="12dp">

                        <ImageView
                            android:id="@+id/printingIcon"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_printing"
                            android:background="@drawable/bg_category_circle"
                            android:padding="12dp" />

                        <TextView
                            android:id="@+id/printingLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Printing"
                            android:textSize="12sp"
                            android:textColor="@color/text_primary_light"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/categoryDailyUseContainer"
                        android:layout_width="72dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true"
                        android:layout_marginEnd="12dp">

                        <ImageView
                            android:id="@+id/dailyUseIcon"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_daily_use"
                            android:background="@drawable/bg_category_circle"
                            android:padding="12dp" />

                        <TextView
                            android:id="@+id/dailyUseLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Daily Use"
                            android:textSize="12sp"
                            android:textColor="@color/text_primary_light"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/categoryMiscContainer"
                        android:layout_width="72dp"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:clickable="true"
                        android:focusable="true">

                        <ImageView
                            android:id="@+id/miscIcon"
                            android:layout_width="48dp"
                            android:layout_height="48dp"
                            android:src="@drawable/ic_misc"
                            android:background="@drawable/bg_category_circle"
                            android:padding="12dp" />

                        <TextView
                            android:id="@+id/miscLabel"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Misc"
                            android:textSize="12sp"
                            android:textColor="@color/text_primary_light"
                            android:layout_marginTop="4dp" />
                    </LinearLayout>

                </LinearLayout>
            </HorizontalScrollView>

            <!-- "All Vendors" section header -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:paddingHorizontal="16dp"
                android:paddingBottom="8dp">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="All Vendors"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary_light" />

                <TextView
                    android:id="@+id/viewAllText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="View All"
                    android:textColor="@color/primary_green"
                    android:textSize="14sp"
                    android:clickable="true"
                    android:focusable="true" />
            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/vendorRecyclerView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingHorizontal="16dp"
                android:paddingBottom="16dp"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>