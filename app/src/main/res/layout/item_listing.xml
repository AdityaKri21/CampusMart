<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="12dp"
    app:cardElevation="2dp"
    app:cardBackgroundColor="@color/surface_light">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="14dp">

        <ImageView
            android:id="@+id/listingImage"
            android:layout_width="80dp"
            android:layout_height="80dp"
            android:scaleType="centerCrop"
            android:background="@color/background_light" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:paddingStart="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/listingTitle"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Item Title"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/text_primary_light" />

                <TextView
                    android:id="@+id/listingCondition"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Used"
                    android:textColor="@color/surface_light"
                    android:background="@color/text_secondary_light"
                    android:paddingHorizontal="8dp"
                    android:paddingVertical="3dp"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/listingDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Description"
                android:textSize="13sp"
                android:textColor="@color/text_secondary_light"
                android:layout_marginTop="4dp"
                android:maxLines="2"
                android:ellipsize="end" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginTop="10dp">

                <TextView
                    android:id="@+id/listingPrice"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="₹0"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@color/primary_green" />

                <TextView
                    android:id="@+id/listingSeller"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="by Seller"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary_light" />

            </LinearLayout>
            <Button
                android:id="@+id/showContactButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Show Contact"
                android:backgroundTint="@color/accent_blue"
                android:textSize="13sp"
                android:layout_marginTop="10dp" />

            <TextView
                android:id="@+id/contactInfoText"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Contact: "
                android:textSize="13sp"
                android:textColor="@color/text_primary_light"
                android:background="@color/primary_green_light"
                android:padding="10dp"
                android:visibility="gone"
                android:layout_marginTop="8dp" />
            <Button
                android:id="@+id/deleteListingButton"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Remove Listing"
                android:backgroundTint="@color/error_red"
                android:textSize="13sp"
                android:visibility="gone"
                android:layout_marginTop="10dp" />

        </LinearLayout>
    </LinearLayout>
</androidx.cardview.widget.CardView>