<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/surface_light"
    android:layout_marginTop="40dp">

    <EditText
        android:id="@+id/shopNameInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Shop Name"
        android:padding="12dp"
        android:textColor="@color/text_primary_light"
        android:textColorHint="@color/text_secondary_light"
        android:background="@drawable/bg_input_field"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/shopCategoryInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Category (e.g. Food, Stationery)"
        android:padding="12dp"
        android:textColor="@color/text_primary_light"
        android:textColorHint="@color/text_secondary_light"
        android:background="@drawable/bg_input_field"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/shopLocationInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Location (e.g. Near Library)"
        android:padding="12dp"
        android:textColor="@color/text_primary_light"
        android:textColorHint="@color/text_secondary_light"
        android:background="@drawable/bg_input_field" />

</LinearLayout>
