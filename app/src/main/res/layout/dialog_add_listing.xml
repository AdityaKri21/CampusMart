<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="20dp"
    android:background="@color/surface_light"
    android:layout_marginTop="40dp">

    <EditText
        android:id="@+id/listingTitleInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Item Title"
        android:padding="12dp"
        android:textColor="@color/text_primary_light"
        android:textColorHint="@color/text_secondary_light"
        android:background="@drawable/bg_input_field"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/listingDescInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Description"
        android:padding="12dp"
        android:textColor="@color/text_primary_light"
        android:textColorHint="@color/text_secondary_light"
        android:background="@drawable/bg_input_field"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/listingPriceInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Price"
        android:inputType="numberDecimal"
        android:padding="12dp"
        android:textColor="@color/text_primary_light"
        android:textColorHint="@color/text_secondary_light"
        android:background="@drawable/bg_input_field"
        android:layout_marginBottom="12dp" />

    <EditText
        android:id="@+id/listingCategoryInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Category (Books, Electronics, Furniture...)"
        android:padding="12dp"
        android:textColor="@color/text_primary_light"
        android:textColorHint="@color/text_secondary_light"
        android:background="@drawable/bg_input_field"
        android:layout_marginBottom="12dp" />
    <EditText
        android:id="@+id/listingImageUrlInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Image URL (optional)"
        android:padding="12dp"
        android:textColor="@color/text_primary_light"
        android:textColorHint="@color/text_secondary_light"
        android:background="@drawable/bg_input_field"
         />
    <EditText
        android:id="@+id/listingContactInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:hint="Contact (Phone or Email)"
        android:padding="12dp"
        android:textColor="@color/text_primary_light"
        android:textColorHint="@color/text_secondary_light"
        android:background="@drawable/bg_input_field"
        android:layout_marginTop="12dp" />
    <Spinner
        android:layout_marginTop="20dp"
        android:id="@+id/conditionSpinner"
        android:layout_width="match_parent"
        android:layout_height="wrap_content" />

</LinearLayout>