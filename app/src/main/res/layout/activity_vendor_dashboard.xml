<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background_light"
    android:layout_marginTop="20dp">

    <LinearLayout
        android:id="@+id/vendorDashHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="16dp"
        android:background="@color/surface_light"
        android:elevation="4dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_marginTop="30dp">

        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:src="@android:drawable/ic_menu_close_clear_cancel"
            android:background="@android:color/transparent" />

        <TextView
            android:id="@+id/vendorShopNameHeader"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="My Shop"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="@color/text_primary_light"
            android:paddingStart="12dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        app:layout_constraintTop_toBottomOf="@id/vendorDashHeader">

        <Button
            android:id="@+id/manageProductsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Manage Products"
            android:padding="16dp"
            android:backgroundTint="@color/primary_green"
            android:layout_marginBottom="12dp" />

        <Button
            android:id="@+id/manageOrdersButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Orders"
            android:padding="16dp"
            android:backgroundTint="@color/accent_blue" />
        <Button
            android:id="@+id/editShopDetailsButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Edit Shop Details"
            android:padding="16dp"
            android:backgroundTint="@color/accent_purple"
            android:layout_marginTop="12dp" />
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>